# OS
.DS_Store

# Dependencies
node_modules
yarn.lock

# Build output
build
dist
/.build/_*
# Generated by software/scripts/mac/file-association.js — mac-only, so a linux
# CI prep can never regenerate them after clean_artifacts wipes .build/, and
# their staged deletions used to leak into the prep patch.
/.build/file-association-mac*.sh
# Pre-restore snapshots written by software/tools/restore-xfce-config.js before
# it applies changes - local-only undo points, never committed.
/.build/tar-xcfe-config.pre-restore-*.tar.gz
software/types/

# Editor / IDE
.cache
.playwright-mcp/
.prettier-cache
.vs-code

# Claude Code
.claude/*
!.claude/settings.json
!.claude/skills

# Environment / secrets
.env
.npmrc

# Test / coverage
coverage
.nyc_output
unit-test-output.txt

# Logs
DEBUG
Error
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*storybook.log

# Misc
*.tmp
*.LICENSE.txt
*.patch
*.rej
*.bak_original
*.bak_latest
public/vs
upload

# /plan-and-commit work artifacts now live in ~/sy/ai_llm/plans/<repo>/, outside
# every repo. These patterns stay as a safety net so a stray plan written into
# the repo root by an older agent still can't be committed.
/plan-*.md
/plan-*.diff

# Release-asset fallback cache lives in the binary-cache release on synle/bashrc,
# not in the repo. Block accidental local re-introduction.
assets/binaries/

# Per-OS precompiled profile snapshots are generated by each CI build job,
# uploaded as `profile-build-*` artifacts (copied into dist/ by publish for
# the webapp to fetch same-origin), and mirrored to the binary-cache release
# as `bashrc-profile__profile_bashrc_<os>.sh`. Never committed back.
.build/profile_bashrc_*.sh


.pnp.cjs
.pnp.loader.mjs
.yarn

